# Admin Authentication Credentials
# Configure credentials for logging into the /admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Cloud Database Persistence (MongoDB Atlas Free Tier)
# Prevents data from disappearing after deployment on Netlify / Vercel / Render
# Obtain your free URI at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio

# Server Port (default: 3100, cloud hosts like Render/Railway automatically assign PORT)
PORT=3100

# Environment Mode
NODE_ENV=production